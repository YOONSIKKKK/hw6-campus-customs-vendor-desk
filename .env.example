# Copy this file to .env in the project root and fill in your own key.
#
#   cp .env.example .env
#
# The scripts look for .env beside them first, then one directory up (the course
# layout). Either location works.
#
# Never commit the real .env - .gitignore already excludes it.

PORTKEY_API_KEY=pk-your-portkey-key-here
